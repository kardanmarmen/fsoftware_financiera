{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsoftware-financiera",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: registra cada petición con su tiempo de CPU (panel > Observability).
  "observability": { "enabled": true },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // Cualquier página (/usuarios, /bitacora...) recibe index.html sin ejecutar el Worker;
    // las peticiones que no son de navegación, como /api, sí llegan al Worker.
    "not_found_handling": "single-page-application"
  },
  // Límite de intentos de inicio de sesión: 5 por minuto por IP y usuario (server/api/auth/iniciar-sesion.post.ts).
  "ratelimits": [
    { "name": "LIMITE_INICIO_SESION", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financiera",
      "database_id": "7335738d-0e91-407b-a9c6-b291c3d8d313",
      "migrations_dir": "server/db/migraciones"
    }
  ]
}
