{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financiera",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "financiera",
      "database_id": "7335738d-0e91-407b-a9c6-b291c3d8d313",
      "migrations_dir": "server/db/migraciones"
    }
  ]
}
