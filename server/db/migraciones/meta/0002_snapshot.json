        "estado_credito_valido": {
          "name": "estado_credito_valido",
          "value": "\"creditos\".\"estado\" IN ('aprobado', 'aceptado', 'liquidado', 'cancelado')"
        },
        "tipo_liquidacion_valido": {
          "name": "tipo_liquidacion_valido",
          "value": "\"creditos\".\"tipo_liquidacion\" IN ('normal', 'anticipada')"
        },
        "monto_credito_positivo": {
          "name": "monto_credito_positivo",
          "value": "\"creditos\".\"monto_centavos\" > 0"
        },
        "plazo_credito_positivo": {
