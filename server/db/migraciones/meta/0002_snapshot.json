          "value": "\"creditos\".\"plazo_semanas\" > 0"
        },
        "saldo_no_negativo": {
          "name": "saldo_no_negativo",
          "value": "\"creditos\".\"saldo_centavos\" >= 0"
        },
        "total_cuadra": {
          "name": "total_cuadra",
          "value": "\"creditos\".\"total_centavos\" = \"creditos\".\"monto_centavos\" + \"creditos\".\"interes_centavos\""
        },
        "saldo_hasta_total": {
          "name": "saldo_hasta_total",
          "value": "\"creditos\".\"saldo_centavos\" <= \"creditos\".\"total_centavos\""
        },
        "liquidado_sin_saldo": {
          "name": "liquidado_sin_saldo",
          "value": "\"creditos\".\"estado\" <> 'liquidado' OR (\"creditos\".\"saldo_centavos\" = 0 AND \"creditos\".\"liquidado_en\" IS NOT NULL)"
        }
